PORT=4000
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never put in the app
CORS_ORIGIN=*  # comma-separated; or * / omit for native-only app
CRON_SECRET=use-a-long-random-secret-for-the-reminder-endpoint

# Mailer configuration (for partner credentials & password reset OTP emails)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
