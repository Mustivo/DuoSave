{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false
  },
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/android",
    "**/ios"
  ]
}

