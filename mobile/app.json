{
  "expo": {
    "name": "DuoSave",
    "slug": "duosave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.duosave.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.duosave.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1128"
      }
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#2ED07C"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2ED07C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A1128"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "42f59699-5120-400c-aaf0-485b2346703f"
      }
    }
  }
}
